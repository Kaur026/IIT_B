# Keep authentication disabled until trusted adapters and HTTP authorization
# tests are verified. Values below are placeholders, not usable credentials.
B2_AUTH_MODE=disabled
B2_ENV=development
B2_PREPARED_SUMMARY_PUBLIC=false
# Row-level prepared records require reviewed trusted auth, role, scope, and worker mappings.
B2_PREPARED_ROWS_ENABLED=false
B2_PREPARED_PREVIEW_ENABLED=false
B2_PREPARED_ROWS_ENABLED=false
B2_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
B2_DB_PATH=./B2/.prototype.sqlite

# Future trusted backend settings; no current runtime adapter consumes them.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
B2_DATABASE_URL=postgresql://user:password@host:5432/database
B2_OPERATIONAL_STORE_KIND=postgresql
