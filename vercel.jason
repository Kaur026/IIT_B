{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "b2": {
      "root": "B2",
      "framework": "fastapi"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "member3_data_simulation": {
      "root": "member3_data_simulation",
      "runtime": "python"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
