# Public Supabase project settings for browser authentication (not secrets).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional public mock-demo role picker for a dedicated static demo deployment.
# It is a UI simulation only and never grants access to B2.
VITE_ENABLE_DEMO_MODE=false

# Leave unset for a mock-only frontend deployment. Configure an HTTPS B2 API
# origin only after trusted backend authentication and authorization are ready.
VITE_B2_API_URL=
